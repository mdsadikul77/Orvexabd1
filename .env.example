# Server Port (for Render / Railway / Koyeb / Local)
PORT=3000

# Permanent Cloud Database (Required for Vercel / Netlify / Serverless & recommended for free Render tier)
# Create a free database at https://turso.tech and paste your URL & Token below:
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Optional: Secret used for signing auth tokens (auto-persisted in DB site_settings if omitted)
SESSION_SECRET=""

# Optional: Comma-separated allowed frontend origins for CORS when split-hosted
ALLOWED_ORIGINS=""

# Optional: Custom persistent disk directory paths for SQLite DB and uploads (Node servers)
DATA_DIR=""
UPLOADS_DIR=""

# Optional: Split-hosting Frontend API Origin (leave EMPTY if deploying Full-Stack on Vercel, Netlify, Render, Railway, etc.)
VITE_API_BASE_URL=""
VITE_WS_BASE_URL=""

# Optional initial admin bootstrap credentials (used only if no admin exists in DB yet)
ADMIN_USERNAME=
ADMIN_INITIAL_PASSWORD=

# APP_URL: Public URL where the app is hosted
APP_URL="MY_APP_URL"
